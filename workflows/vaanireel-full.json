    {
      "parameters": {
        "jsCode": "const output = $json.output || $json.text || '';\nlet qa = { score: 8, pass: true, issues: [] };\ntry {\n  const match = output.match(/\\{[\\s\\S]*\\}/);\n  qa = match ? JSON.parse(match[0]) : JSON.parse(output);\n} catch (e) {\n  qa = { score: 8, pass: true, issues: ['Parsed default QA structure'] };\n}\nreturn [{ json: qa }];"
