    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.message?.photo ? 'photo' : ($json.message?.voice || $json.message?.audio ? 'voice' : 'text') }}",
        "rules": {
          "rules": [
            {
              "value2": "photo",
              "outputKey": "photo"
            },
            {
              "value2": "voice",
              "outputKey": "voice"
            },
            {
              "value2": "text",
              "outputKey": "text"
            }
          ]
        }
      },
