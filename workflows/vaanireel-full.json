      "position": [
        -960,
        300
      ],
      "id": "node-switch-message-type",
      "name": "Switch Message Type"
    },
    {
      "parameters": {
        "operation": "upsert",
        "dataTableId": {
          "__rl": true,
          "value": "vaanireel_sessions",
          "mode": "name"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "chat_id",
              "keyValue": "={{ $json.message.chat.id.toString() }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "chat_id": "={{ $json.message.chat.id.toString() }}",
            "photo_file_id": "={{ $json.message.photo[$json.message.photo.length - 1].file_id }}"
