    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id.toString() }}",
        "text": "👋 Vanakkam! Welcome to VaaniReel.\n\nTo create an Instagram marketing post for your shop:\n1. Send a clear photo of your product.\n2. Send a voice note in Tamil, Hindi, or English describing it.\n\nOur AI will write local copy, stage a festive marketing photo, record a voiceover, and prepare an Instagram post for your approval!",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        -680,
        500
      ],
      "id": "node-telegram-welcome",
      "name": "Telegram Welcome Message",
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram"
        }
      }
    },
    {
      "parameters": {
        "operation": "get",
